# S1 slice: if/else chains, nested branches, early returns, joins
fn classify(x: Int) -> Str {
  if x < 0 {
    return "neg"
  } else {
    if x == 0 {
      return "zero"
    } else {
      return "pos"
    }
  }
}
fn abs(x: Int) -> Int {
  if x < 0 {
    return 0 - x
  }
  return x
}
fn main() {
  promote(classify(-5))
  promote(classify(0))
  promote(classify(7))
  promote(abs(-3))
  promote(abs(3))
  let label: Str = "end"
  promote(label)
}
